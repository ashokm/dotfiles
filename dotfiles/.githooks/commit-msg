#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

message_file="${1:?missing commit message file}"

# Strip AI-generated "Co-authored-by" trailers silently before any validation.
# Matches lines whose email contains [bot] or whose name contains a known AI tool.
# Human co-authors are left untouched.
tmp="$(mktemp)"
if grep -Eiv '^Co-authored-by:.*(\[bot\]|copilot|gemini|claude|cursor|chatgpt|openai)' \
  "$message_file" > "$tmp"; then
  mv "$tmp" "$message_file"
else
  rm -f "$tmp"
fi

# Git may include comments and blank lines before the actual commit header.
first_line="$(
  awk '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    {
      sub(/\r$/, "")
      print
      exit
    }
  ' "$message_file"
)"

if [[ -z "$first_line" ]]; then
  echo "ERROR: commit message header is required." >&2
  exit 1
fi

# Merge-style headers do not follow the project commit convention.
# Skip header validation but still enforce line length.
is_merge_commit=false
if [[ "$first_line" =~ ^Merge[[:space:]] ]]; then
  is_merge_commit=true
fi

# Keep the allowed types in sync with the branch naming convention.
standard_header_pattern='^(feat|fix|docs|style|refactor|perf|test|chore)(\([a-z0-9._/-]+\))?: [a-z]([^.]|.*[^.])$'
revert_header_pattern='^revert: (feat|fix|docs|style|refactor|perf|test|chore)(\([a-z0-9._/-]+\))?: [a-z]([^.]|.*[^.])$'

if [[ "$is_merge_commit" == false ]] &&
  [[ ! "$first_line" =~ $standard_header_pattern ]] &&
  [[ ! "$first_line" =~ $revert_header_pattern ]]; then
  cat >&2 << 'EOF'
ERROR: invalid commit header.
Expected: <type>(<scope>): <subject>

Allowed types:
feat, fix, docs, style, refactor, perf, test, chore

Reverts must start with:
revert: <type>(<scope>): <subject>
EOF
  exit 1
fi

# Require a body for non-merge commits: at least one non-empty, non-comment line
# after the header line.
if [[ "$is_merge_commit" == false ]]; then
  has_body=false
  line_number=0
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    line="${line%$'\r'}"
    ((line_number += 1))

    # Skip the header line; body starts after it.
    if (( line_number == 1 )); then
      continue
    fi

    if [[ -n "${line//[[:space:]]/}" ]]; then
      has_body=true
      break
    fi
  done < "$message_file"

  if [[ "$has_body" == false ]]; then
    cat >&2 << 'EOF'
ERROR: commit body is required.
Add a blank line after the header, then include at least one body line describing what and why.
EOF
    exit 1
  fi
fi

# Git comment lines are metadata and are not part of the commit message.
awk '
  /^[[:space:]]*#/ { next }
  {
    sub(/\r$/, "")
  }
  length($0) > 100 {
    printf "ERROR: line %d exceeds 100 characters:\n%s\n", NR, $0 > "/dev/stderr"
    failed = 1
  }
  END {
    exit failed
  }
' "$message_file"
